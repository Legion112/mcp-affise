# Optional path to tenants file (default: tenants.yaml)
# AFFISE_TENANTS_FILE=tenants.yaml

# Per-tenant credentials (ID uppercased, non-alnum -> _)
# Example tenant id "traffgun":
AFFISE_TENANT_TRAFFGUN_HOST=api-traffgun.affise.com
AFFISE_TENANT_TRAFFGUN_TOKEN=your_api_key_here

# Optional dotenv path override for MCP process
# AFFISE_DOTENV=.env
